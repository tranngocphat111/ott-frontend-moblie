{
  "expo": {
    "name": "Riff",
    "slug": "Riff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_tach_nen.jpg",
    "scheme": "riff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "chucnguyen02",

    "ios": {
      "bundleIdentifier": "com.chucnguyen02.ottapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "192.168.1.73": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },

    "android": {
      "package": "com.chucnguyen02.ottapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo_tach_nen.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },

    "web": {
      "output": "static",
      "favicon": "./assets/logo.jpg"
    },

    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép truy cập thư viện ảnh để gửi hình ảnh trong cuộc trò chuyện",
          "cameraPermission": "Cho phép truy cập camera để chụp ảnh và gửi trong cuộc trò chuyện"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Cho phép truy cập micro để ghi âm và gửi tin nhắn thoại"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép truy cập thư viện để hiển thị ảnh/video gần đây và gửi trong cuộc trò chuyện"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_tach_nen.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}