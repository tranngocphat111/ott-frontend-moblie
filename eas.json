{
  "cli": {
    "version": ">= 18.13.0"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LIVEKIT_URL": "wss://chat-service-wplw6oap.livekit.cloud",
        "EXPO_PUBLIC_ENABLE_NATIVE_LIVEKIT": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
